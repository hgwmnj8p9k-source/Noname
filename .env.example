# API / engine configuration. Copy to .env and adjust as needed.

# HTTP port for the REST + WebSocket API
PORT=4000
HOST=0.0.0.0

# Paper portfolio starting cash (USD)
STARTING_CASH_USD=10000

# Engine loop interval in milliseconds
TICK_INTERVAL_MS=2000

# Seed for the deterministic offline market simulator
SIM_SEED=1337

# Optional: comma-separated DexScreener search queries to ALSO pull live data.
# Leave empty to run purely on the offline simulator (no network needed).
# Example: DEXSCREENER_QUERIES=SOL,BONK,WIF
DEXSCREENER_QUERIES=

# Start the engine automatically on boot
AUTO_START=true
