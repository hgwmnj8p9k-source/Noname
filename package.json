{
  "name": "noname-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Institutional-grade AI memecoin paper-trading platform",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @noname/api dev",
    "dev:dashboard": "pnpm --filter @noname/dashboard dev",
    "dev:all": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @noname/api dev\" \"pnpm --filter @noname/dashboard dev\"",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "backtest": "pnpm --filter @noname/backtest run run",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
